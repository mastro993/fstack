#!/usr/bin/env python3
"""Stub gh CLI for implement-issue evals: issues, issue dependencies and pull requests for millbrook/readwell.

`git push` to origin lands in ./remote/readwell.git (see place-files.sh). Nothing merges on its own: a
pull request stays open until `gh pr merge`. State lives in .gh-stub/state.json (place-files.sh seeds
it); every call is appended to .gh-stub/calls.log for grading.
"""
import json
import subprocess
import sys
from pathlib import Path

SANDBOX = Path(__file__).resolve().parent.parent
ROOT = SANDBOX / ".gh-stub"
ROOT.mkdir(exist_ok=True)
STORE = ROOT / "state.json"
REMOTE = SANDBOX / "remote" / "readwell.git"
REPO = "millbrook/readwell"
URL = f"https://github.com/{REPO}"
args = sys.argv[1:]
with (ROOT / "calls.log").open("a") as log:
    log.write(json.dumps(args) + "\n")
state = json.loads(STORE.read_text()) if STORE.exists() else {"issues": [], "pulls": [], "next": 14}


def flag(*names, many=False):
    found = [args[i + 1] for i, a in enumerate(args[:-1]) if a in names]
    return found if many else (found[-1] if found else None)


def body():
    path = flag("--body-file", "-F")
    if path:
        return sys.stdin.read() if path == "-" else Path(path).read_text()
    return flag("--body", "-b") or ""


def git(*cmd):
    return subprocess.run(["git", f"--git-dir={REMOTE}", *cmd], capture_output=True, text=True, check=True).stdout.strip()


def save():
    STORE.write_text(json.dumps(state, indent=2))


def output(data):
    text = json.dumps(data)
    jq = flag("--jq", "-q")
    if jq:
        text = subprocess.run(["jq", "-r", jq], input=text, capture_output=True, text=True).stdout.rstrip("\n")
    print(text)


def select(data):
    wanted = flag("--json")
    return {k: v for k, v in data.items() if k in wanted.split(",")} if wanted else data


def number_of(ref):
    return (ref or "").lstrip("#").rstrip("/").rsplit("/", 1)[-1]


def pick(items, ref, kind):
    found = next((i for i in items if i.get("headRefName") == ref or str(i["number"]) == number_of(ref)), None)
    if not found:
        sys.exit(f"no {kind} found for {ref!r}")
    return found


def positional():
    return next((a for a in args[2:] if not a.startswith("-") and args[args.index(a) - 1] not in VALUE_FLAGS), None)


VALUE_FLAGS = {"--json", "--jq", "-q", "--body", "-b", "--body-file", "-F", "--title", "-t", "--base", "-B", "--head", "-H",
               "--state", "-s", "--search", "-S", "--label", "-l", "--limit", "-L", "--name", "-n", "--repo", "-R", "--add-label",
               "--add-assignee", "--remove-assignee"}


def current_branch():
    try:
        return subprocess.run(["git", "rev-parse", "--abbrev-ref", "HEAD"], capture_output=True, text=True, check=True).stdout.strip()
    except subprocess.CalledProcessError:
        return None


def issue_json(issue):
    closing = [{"number": p["number"], "url": p["url"]} for p in state["pulls"] if f"#{issue['number']}" in p["body"]]
    return select(dict(issue, id=issue["number"] + 1000, closedByPullRequestsReferences=closing,
                       assignees=[{"login": a} for a in issue.get("assignees", [])],
                       comments=[{"author": {"login": c["author"]}, "body": c["body"]} for c in issue["comments"]]))


def pr_json(pr):
    return select(dict(pr, mergeable="MERGEABLE", mergeStateStatus="CLEAN", reviewDecision="", headRefOid="",
                       statusCheckRollup=[], closingIssuesReferences=[{"number": i["number"]} for i in state["issues"]
                                                                       if f"#{i['number']}" in pr["body"]]))


def matches(pr):
    wanted = (flag("--state", "-s") or "open").upper()
    head = flag("--head", "-H")
    search = (flag("--search", "-S") or "").lower()
    terms = [t for t in search.replace("in:body", "").replace("in:title", "").split() if ":" not in t]
    text = f"{pr['title']} {pr['body']} {pr['headRefName']}".lower()
    return (wanted == "ALL" or pr["state"] == wanted) and (not head or pr["headRefName"] == head) and all(t.lstrip("#") in text for t in terms)


cmd = args[:2]
if "--help" in args or "-h" in args:
    print(f"gh stub: usage for `gh {' '.join(a for a in args if not a.startswith('-'))}` is not available in this sandbox")
elif args[:1] in (["--version"], ["version"]):
    print("gh version 2.103.3 (2026-10-26)")
elif cmd == ["auth", "status"]:
    print("github.com\n  ✓ Logged in to github.com account millbrook-volunteer")
elif cmd == ["repo", "view"]:
    output({"nameWithOwner": REPO, "url": URL, "defaultBranchRef": {"name": "main"}, "squashMergeAllowed": True})
elif cmd == ["label", "list"]:
    print("enhancement\tNew feature or request\t#a2eeef\nbug\tSomething isn't working\t#d73a4a")
elif cmd == ["issue", "list"]:
    issues = [i for i in state["issues"] if (flag("--state", "-s") or "open").upper() in ("ALL", i["state"])]
    if "--json" in args:
        output([issue_json(i) for i in issues])
    else:
        for i in issues:
            print(f"{i['number']}\t{i['state']}\t{i['title']}\t{','.join(i['labels'])}")
elif cmd == ["issue", "view"]:
    issue = pick(state["issues"], positional(), "issues")
    if "--json" in args:
        output(issue_json(issue))
    else:
        print(f"title:\t{issue['title']}\nstate:\t{issue['state']}\nassignees:\t{', '.join(issue.get('assignees', []))}\n"
              f"labels:\t{', '.join(issue['labels'])}\nnumber:\t{issue['number']}\n--\n{issue['body']}")
        if "--comments" in args or "-c" in args:
            for c in issue["comments"]:
                print(f"\n--\nauthor:\t{c['author']}\n--\n{c['body']}")
elif cmd == ["issue", "comment"]:
    issue = pick(state["issues"], positional(), "issues")
    if "--edit-last" in args and any(c["author"] == "millbrook-volunteer" for c in issue["comments"]):
        next(c for c in reversed(issue["comments"]) if c["author"] == "millbrook-volunteer")["body"] = body()
    else:
        issue["comments"].append({"author": "millbrook-volunteer", "body": body()})
    save()
    print(f"{issue['url']}#issuecomment-{len(issue['comments'])}")
elif cmd == ["issue", "edit"]:
    issue = pick(state["issues"], positional(), "issues")
    if flag("--body", "-b", "--body-file", "-F"):
        issue["body"] = body()
    issue["labels"] += flag("--add-label", many=True)
    for login in flag("--add-assignee", many=True):
        for name in login.split(","):
            name = "millbrook-volunteer" if name == "@me" else name
            if name not in issue.setdefault("assignees", []):
                issue["assignees"].append(name)
    save()
    print(issue["url"])
elif cmd == ["issue", "develop"]:
    issue = pick(state["issues"], positional(), "issues")
    if "--list" in args:
        for b in issue.get("linkedBranches", []):
            print(f"{b}\t{URL}/tree/{b}")
    else:
        name = flag("--name", "-n") or f"{issue['number']}-{'-'.join(issue['title'].lower().split()[:5])}"
        base = flag("--base", "-b") or "main"
        git("update-ref", f"refs/heads/{name}", git("rev-parse", f"refs/heads/{base}"))
        issue.setdefault("linkedBranches", []).append(name)
        save()
        if "--checkout" in args or "-c" in args:
            subprocess.run(["git", "fetch", "-q", "origin"], check=True)
            subprocess.run(["git", "checkout", "-q", "-b", name, "--track", f"origin/{name}"], check=True)
        print(f"{URL}/tree/{name}")
elif cmd == ["pr", "create"]:
    head = flag("--head", "-H") or current_branch()
    try:
        git("rev-parse", f"refs/heads/{head}")
    except subprocess.CalledProcessError:
        sys.exit("aborted: you must first push the current branch to a remote, or use the --head flag")
    pr = {"number": state["next"], "title": flag("--title", "-t"), "body": body(), "headRefName": head,
          "baseRefName": flag("--base", "-B") or "main", "isDraft": "--draft" in args or "-d" in args, "state": "OPEN"}
    pr["url"] = f"{URL}/pull/{pr['number']}"
    state["next"] += 1
    state["pulls"].append(pr)
    save()
    print(pr["url"])
elif cmd == ["pr", "view"]:
    pr = pick(state["pulls"], positional() or current_branch(), "pull requests")
    if "--json" in args:
        output(pr_json(pr))
    else:
        draft = " (draft)" if pr["isDraft"] else ""
        print(f"title:\t{pr['title']}\nstate:\t{pr['state']}{draft}\nnumber:\t{pr['number']}\nurl:\t{pr['url']}\n"
              f"head:\t{pr['headRefName']}\n--\n{pr['body']}")
elif cmd == ["pr", "list"]:
    found = [p for p in state["pulls"] if matches(p)]
    if "--json" in args:
        output([pr_json(p) for p in found])
    else:
        for p in found:
            print(f"{p['number']}\t{p['title']}\t{p['headRefName']}\t{'DRAFT' if p['isDraft'] else p['state']}")
elif cmd == ["pr", "edit"]:
    pr = pick(state["pulls"], positional() or current_branch(), "pull requests")
    if flag("--title", "-t"):
        pr["title"] = flag("--title", "-t")
    if flag("--body", "-b", "--body-file", "-F"):
        pr["body"] = body()
    save()
    print(pr["url"])
elif cmd == ["pr", "diff"]:
    pr = pick(state["pulls"], positional() or current_branch(), "pull requests")
    print(git("diff", f"refs/heads/{pr['baseRefName']}...refs/heads/{pr['headRefName']}"))
elif cmd == ["pr", "checks"]:
    print("[]" if "--json" in args else "no checks reported on the branch")
elif cmd == ["pr", "ready"]:
    pick(state["pulls"], positional() or current_branch(), "pull requests")["isDraft"] = "--undo" in args
    save()
elif cmd == ["pr", "merge"]:
    sys.exit("gh stub: merging is not available in this sandbox")
elif args[:1] == ["api"] and args[1] != "graphql":
    path = next(a for a in args[1:] if not a.startswith("-") and a.lstrip("/").startswith("repos/")).lstrip("/").split("?")[0]
    parts = path.split("/")
    issue = pick(state["issues"], parts[4], "issues") if len(parts) > 4 and parts[3] == "issues" else None
    if issue and path.endswith("dependencies/blocked_by"):
        output([issue_json(pick(state["issues"], str(n), "issues")) for n in issue["blockedBy"]])
    elif issue and path.endswith("comments"):
        output(issue_json(issue)["comments"])
    elif issue and len(parts) == 5:
        output(issue_json(issue))
    else:
        sys.exit(f"gh stub: `gh api {path}` is not available in this sandbox")
else:
    sys.exit(f"gh stub: `gh {' '.join(args[:2])}` is not available in this sandbox (issues, issue dependencies and pull requests only)")
