{% extends "layout.njk" %}

{% block content %}
  <p style="margin:0 0 4px;font-size:12px;letter-spacing:.04em;text-transform:uppercase;color:#7b8794;">{{ label }}</p>
  <h1 style="margin:0 0 16px;font-size:20px;line-height:28px;">{{ title }}</h1>
  <p style="margin:0 0 24px;font-size:15px;line-height:22px;white-space:pre-line;">{{ body }}</p>
  {% if data.url %}
    <table role="presentation" cellpadding="0" cellspacing="0" border="0">
      <tr>
        <td style="border-radius:6px;background:#1f2933;">
          <a href="{{ data.url }}" style="display:inline-block;padding:10px 18px;color:#ffffff;text-decoration:none;font-weight:600;">Open in Relay</a>
        </td>
      </tr>
    </table>
  {% endif %}
{% endblock %}
