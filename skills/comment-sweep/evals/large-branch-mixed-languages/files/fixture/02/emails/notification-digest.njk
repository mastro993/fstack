{% extends "layout.njk" %}

{% block content %}
  <h1 style="margin:0 0 8px;font-size:20px;line-height:28px;">Your week in Relay</h1>
  <p style="margin:0 0 24px;font-size:15px;line-height:22px;color:#52606d;">
    Hi {{ name }}, here's what happened while you were away.
  </p>

  {% if items | length == 0 %}
    <p style="margin:0;font-size:15px;">Nothing new this week.</p>
  {% else %}
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
      {# Loop over the notifications #}
      {% for item in items %}
        <tr>
          <td style="padding:12px 0;border-bottom:1px solid #e4e7eb;">
            <a href="{{ appUrl }}/notifications/{{ item.id }}" style="color:#1f2933;text-decoration:none;font-weight:600;font-size:15px;">{{ item.title }}</a>
            <p style="margin:4px 0 0;font-size:13px;line-height:19px;color:#616e7c;">{{ item.body | truncate(140) }}</p>
            <p style="margin:4px 0 0;font-size:12px;color:#9aa5b1;">{{ item.createdAt | shortDate }}</p>
          </td>
        </tr>
      {% endfor %}
    </table>
    {% if items | length >= 20 %}
      <p style="margin:16px 0 0;font-size:13px;">
        <a href="{{ appUrl }}/notifications" style="color:#1f2933;">See everything in Relay</a>
      </p>
    {% endif %}
  {% endif %}
{% endblock %}
