#!/usr/bin/env python3
"""Stub gh CLI for receiving-code-review evals.

Simulates one pull request (scenario "number") on top of the local bare repository
remote/<repo name>.git, which `git push` reaches through the checkout's url.insteadOf. Its review
threads, reviews, conversation comments, and linked issues come from .gh-stub/scenario.json.
Replies, resolutions, comments, reviews, and merges the run makes go to .gh-stub/state.json, each
with head_at_post (the PR branch's commit at that moment); every call is appended to
.gh-stub/calls.log; pushed.diff holds what reached the PR branch since state["initial_head"].
"""

import hashlib
import json
import re
import shlex
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
STUB = ROOT / ".gh-stub"
SCN = json.loads((STUB / "scenario.json").read_text())
STATE_FILE = STUB / "state.json"
OWNER, REPO = SCN["repo"].split("/")
REMOTE = ROOT / "remote" / f"{REPO}.git"
N = SCN["number"]
HOST = SCN["host"]
URL = f"https://{HOST}/{SCN['repo']}/pull/{N}"
VIEWER = SCN["viewer"]
BOTS = set(SCN.get("bots", []))

STATE = json.loads(STATE_FILE.read_text()) if STATE_FILE.exists() else {}
for key, empty in (("replies", {}), ("resolved", []), ("unresolved", []), ("comments", []), ("reviews", []),
                   ("edits", []), ("merged", False), ("seq", 0)):
    STATE.setdefault(key, empty)


def git(*args):
    return subprocess.run(["git", "--git-dir", str(REMOTE), *args], capture_output=True, text=True,
                          check=True).stdout.strip()


def head():
    return git("rev-parse", f"refs/heads/{SCN['head']}")


def base_sha():
    return git("rev-parse", f"refs/heads/{SCN['base']}")


def nid(prefix):
    STATE["seq"] += 1
    return f"{prefix}_{STATE['seq']}"


def dbid(node_id):
    return int(hashlib.sha1(node_id.encode()).hexdigest()[:7], 16)


def author(login):
    return {"login": login, "__typename": "Bot" if login in BOTS else "User"}


def rest_user(login):
    return {"login": f"{login}[bot]" if login in BOTS else login, "type": "Bot" if login in BOTS else "User"}


def stamp():
    return {"head_at_post": head()}


# ---------- the PR as GitHub reports it ----------

def thread_nodes():
    out = []
    for t in SCN.get("threads", []):
        comments = [{"id": c["id"], "databaseId": dbid(c["id"]), "author": author(c["author"]), "body": c["body"],
                     "url": f"{URL}#discussion_r{dbid(c['id'])}", "createdAt": c.get("at", "2026-11-25T09:00:00Z"),
                     "path": t["path"], "line": t["line"], "originalLine": t["line"],
                     "commit": {"oid": t.get("commit") or head()}, "originalCommit": {"oid": t.get("commit") or head()},
                     "replyTo": None} for c in t["comments"]]
        for r in STATE["replies"].get(t["id"], []):
            comments.append({**r, "path": t["path"], "line": t["line"], "replyTo": {"id": comments[0]["id"]}})
        resolved = t.get("resolved", False)
        if t["id"] in STATE["resolved"]:
            resolved = True
        if t["id"] in STATE["unresolved"]:
            resolved = False
        out.append({"id": t["id"], "isResolved": resolved, "isOutdated": t.get("outdated", False),
                    "isCollapsed": resolved, "path": t["path"], "line": t["line"], "startLine": t.get("start_line"),
                    "originalLine": t["line"], "originalStartLine": t.get("start_line"), "diffSide": "RIGHT",
                    "subjectType": "LINE", "resolvedBy": None,
                    "comments": {"totalCount": len(comments), "nodes": comments,
                                 "pageInfo": {"hasNextPage": False, "endCursor": None}}})
    return out


def review_nodes():
    out = [{"id": r["id"], "databaseId": dbid(r["id"]), "author": author(r["author"]), "state": r["state"],
            "body": r.get("body", ""), "url": f"{URL}#pullrequestreview-{dbid(r['id'])}",
            "submittedAt": r.get("at", "2026-11-25T09:00:00Z"), "commit": {"oid": r.get("commit") or head()}}
           for r in SCN.get("reviews", [])]
    return out + STATE["reviews"]


def comment_nodes():
    out = [{"id": c["id"], "databaseId": dbid(c["id"]), "author": author(c["author"]), "body": c["body"],
            "url": f"{URL}#issuecomment-{dbid(c['id'])}", "createdAt": c.get("at", "2026-11-25T09:00:00Z")}
           for c in SCN.get("comments", [])]
    return out + STATE["comments"]


def changed_files():
    names = git("diff", "--name-only", f"{base_sha()}...{head()}").splitlines()
    return [{"path": p, "filename": p, "additions": 0, "deletions": 0, "status": "modified",
             "patch": git("diff", f"{base_sha()}...{head()}", "--", p)} for p in names]


def pr_json():
    return {
        "id": f"PR_kwDO{N}", "number": N, "url": URL, "title": SCN["title"], "body": SCN.get("body", ""),
        "state": "MERGED" if STATE["merged"] else "OPEN", "isDraft": False, "closed": STATE["merged"],
        "merged": STATE["merged"], "headRefName": SCN["head"], "headRefOid": head(), "baseRefName": SCN["base"],
        "baseRefOid": base_sha(), "author": author(SCN["author"]), "isCrossRepository": False,
        "headRepository": {"name": REPO}, "headRepositoryOwner": {"login": OWNER},
        "mergeable": "MERGEABLE", "mergeStateStatus": "CLEAN", "reviewDecision": SCN.get("review_decision", ""),
        "reviewRequests": [], "statusCheckRollup": [], "labels": [], "assignees": [],
        "closingIssuesReferences": [{"number": i["number"], "title": i["title"]} for i in SCN.get("issues", [])],
        "files": [{"path": f["path"], "additions": 0, "deletions": 0} for f in changed_files()],
        "commits": [{"oid": s} for s in git("rev-list", "--reverse", f"{base_sha()}..{head()}").splitlines()],
        "reviews": review_nodes(), "latestReviews": review_nodes(), "comments": comment_nodes(),
        "reviewThreads": thread_nodes(),
    }


# ---------- argument helpers ----------

def flag(args, *names):
    for i, a in enumerate(args):
        for n in names:
            if a == n and i + 1 < len(args):
                return args[i + 1]
            if a.startswith(n + "="):
                return a.split("=", 1)[1]
    return None


def fields(args):
    vals = {}
    for i, a in enumerate(args):
        if a in ("-f", "-F", "--field", "--raw-field") and i + 1 < len(args):
            k, _, v = args[i + 1].partition("=")
            if v.startswith("@") and Path(v[1:]).exists():
                v = Path(v[1:]).read_text()
            elif v == "@-":
                v = sys.stdin.read()
            vals[k] = v
    src = flag(args, "--input")
    if src:
        body = json.loads(sys.stdin.read() if src == "-" else Path(src).read_text())
        vals.update(body.get("variables", {}) if "query" in body else body)
        if "query" in body:
            vals["query"] = body["query"]
    return vals


def body_arg(args):
    src = flag(args, "--body-file", "-F")
    if src:
        return sys.stdin.read() if src == "-" else Path(src).read_text()
    return flag(args, "--body", "-b") or ""


def emit(obj, args):
    jq = flag(args, "-q", "--jq")
    if "--slurp" in args:
        if jq:
            print("the `--slurp` option is not supported with `--jq` or `--template`", file=sys.stderr)
            return 1
        obj = [obj]  # one page
    text = json.dumps(obj)
    if jq:
        proc = subprocess.run(["jq", "-r", jq], input=text, capture_output=True, text=True)
        sys.stdout.write(proc.stdout)
        sys.stderr.write(proc.stderr)
        return proc.returncode
    if flag(args, "-t", "--template"):
        print(text)
        return 0
    print(text)
    return 0


def select(obj, keys):
    return {k: obj.get(k) for k in keys.split(",")} if keys else obj


# ---------- writes ----------

def thread_of_comment(comment_ref):
    """The thread holding a comment, by node id or numeric database id."""
    for t in thread_nodes():
        for c in t["comments"]["nodes"]:
            if comment_ref in (c["id"], str(c["databaseId"])):
                return t["id"]
    return None


def now():
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def add_reply(thread_id, body):
    reply = {"id": nid("PRRC_reply"), "databaseId": 900000 + STATE["seq"], "author": author(VIEWER), "body": body,
             "url": f"{URL}#discussion_r{900000 + STATE['seq']}", "createdAt": now(), **stamp()}
    STATE["replies"].setdefault(thread_id, []).append(reply)
    return reply


def add_comment(body):
    c = {"id": nid("IC_reply"), "databaseId": 800000 + STATE["seq"], "author": author(VIEWER), "body": body,
         "url": f"{URL}#issuecomment-{800000 + STATE['seq']}", "createdAt": now(), **stamp()}
    STATE["comments"].append(c)
    return c


def add_review(event, body):
    r = {"id": nid("PRR_mine"), "author": author(VIEWER), "state": {"APPROVE": "APPROVED", "REQUEST_CHANGES":
         "CHANGES_REQUESTED"}.get(event.upper(), "COMMENTED"), "body": body, "url": f"{URL}#review",
         "submittedAt": "2026-11-27T12:00:00Z", "commit": {"oid": head()}, **stamp()}
    STATE["reviews"].append(r)
    return r


def merge():
    STATE["merged"] = True
    STATE["merge"] = stamp()


# ---------- GraphQL ----------

def graphql(args):
    v = fields(args)
    q = v.get("query", "")
    known = {t["id"] for t in thread_nodes()}
    values = [str(x) for k, x in v.items() if k != "query"]

    def find_thread():
        tid = next((x for x in values if x in known), None) or next((t for t in known if t in q), None)
        if not tid:
            ref = next((x for x in values if thread_of_comment(x)), None)
            m = re.search(r'inReplyTo:\s*"([^"]+)"', q)
            ref = ref or (m.group(1) if m else None)
            tid = thread_of_comment(ref) if ref else None
        return tid

    def find_body():
        b = v.get("body") or next((x for k, x in v.items() if k not in ("query", "operationName") and x not in known
                                   and not thread_of_comment(x) and not x.startswith(("PR_", "PRRT_"))
                                   and len(x) > 3), "")
        if not b:
            m = re.search(r'body:\s*"((?:[^"\\]|\\.)*)"', q)
            b = json.loads(f'"{m.group(1)}"') if m else ""
        return b

    if "mutation" in q:
        if "addPullRequestReviewThreadReply" in q or "addPullRequestReviewComment" in q:
            tid = find_thread()
            if not tid:
                print("GraphQL: Could not resolve to a node with the global id. (addPullRequestReviewThreadReply)",
                      file=sys.stderr)
                return 1
            reply = add_reply(tid, find_body())
            key = "addPullRequestReviewThreadReply" if "addPullRequestReviewThreadReply" in q else "addPullRequestReviewComment"
            return emit({"data": {key: {"comment": reply}}}, args)
        if "unresolveReviewThread" in q:
            tid = find_thread()
            STATE["unresolved"].append(tid)
            STATE["resolved"] = [t for t in STATE["resolved"] if t != tid]
            return emit({"data": {"unresolveReviewThread": {"thread": {"id": tid, "isResolved": False}}}}, args)
        if "resolveReviewThread" in q:
            tid = find_thread()
            if not tid:
                print("GraphQL: Could not resolve to a node with the global id. (resolveReviewThread)", file=sys.stderr)
                return 1
            STATE["resolved"].append(tid)
            STATE.setdefault("resolved_at", {})[tid] = head()
            return emit({"data": {"resolveReviewThread": {"thread": {"id": tid, "isResolved": True}}}}, args)
        if "addComment" in q:
            c = add_comment(find_body())
            return emit({"data": {"addComment": {"commentEdge": {"node": c}}}}, args)
        if "addPullRequestReview" in q or "submitPullRequestReview" in q:
            m = re.search(r"event:\s*(\w+)", q)
            r = add_review(v.get("event") or (m.group(1) if m else "COMMENT"), find_body())
            return emit({"data": {"addPullRequestReview": {"pullRequestReview": r}}}, args)
        if "mergePullRequest" in q:
            merge()
            return emit({"data": {"mergePullRequest": {"pullRequest": {"merged": True}}}}, args)
        if "updatePullRequestReviewComment" in q or "updateIssueComment" in q:
            STATE["edits"].append({"vars": v, **stamp()})
            return emit({"data": {}}, args)
        print("stub: unsupported mutation", file=sys.stderr)
        return 1
    pr = pr_json()
    conn = lambda nodes: {"totalCount": len(nodes), "nodes": nodes, "pageInfo": {"hasNextPage": False,
                          "hasPreviousPage": False, "endCursor": None, "startCursor": None}}
    gql_pr = {**pr, "reviewThreads": conn(pr["reviewThreads"]), "reviews": conn(pr["reviews"]),
              "comments": conn(pr["comments"]), "files": conn(pr["files"]), "commits": conn(
                  [{"commit": {"oid": c["oid"]}} for c in pr["commits"]]), "latestReviews": conn(pr["reviews"]),
              "closingIssuesReferences": conn(pr["closingIssuesReferences"])}
    if re.search(r"\bnode\s*\(", q):
        ref = next((x for x in values if x in known or thread_of_comment(x)), None) or next(
            (t for t in known if t in q), None)
        node = next((t for t in pr["reviewThreads"] if t["id"] == ref), None)
        if node is None and ref:
            tid = thread_of_comment(ref)
            node = next((c for t in pr["reviewThreads"] for c in t["comments"]["nodes"] if c["id"] == ref), None)
        if node is not None:
            if "comments" in node and isinstance(node["comments"], dict):
                node = {**node}
            return emit({"data": {"node": node}}, args)
    return emit({"data": {"viewer": {"login": VIEWER}, "repository": {
        "id": "R_kwDO", "nameWithOwner": SCN["repo"], "pullRequest": gql_pr}}}, args)


# ---------- REST ----------

def rest_comment(t, c):
    return {"id": c["databaseId"], "node_id": c["id"], "user": rest_user(c["author"]["login"]), "body": c["body"],
            "path": t["path"], "line": t["line"], "original_line": t["line"], "side": "RIGHT",
            "commit_id": c["commit"]["oid"] if "commit" in c else head(), "html_url": c["url"],
            "in_reply_to_id": None if c is t["comments"]["nodes"][0] else t["comments"]["nodes"][0]["databaseId"],
            "pull_request_review_id": None, "created_at": c["createdAt"]}


def rest(args):
    skip = ("-f", "-F", "-X", "--method", "-q", "--jq", "-H", "--header", "--input", "--field", "--raw-field",
            "--hostname", "-t", "--template", "--cache")
    path = next(a for i, a in enumerate(args) if i > 0 and not a.startswith("-") and args[i - 1] not in skip)
    path = path.lstrip("/").split("?")[0].replace("{owner}", OWNER).replace("{repo}", REPO)
    v = fields(args)
    method = (flag(args, "-X", "--method") or ("POST" if v else "GET")).upper()
    base = f"repos/{SCN['repo']}"
    if path == "user":
        return emit({"login": VIEWER, "type": "User"}, args)
    if path == base:
        return emit({"full_name": SCN["repo"], "name": REPO, "owner": {"login": OWNER}, "default_branch": SCN["base"]},
                    args)
    if path in (f"{base}/pulls/{N}", f"{base}/pulls/{N}/"):
        p = pr_json()
        return emit({"number": N, "state": "closed" if STATE["merged"] else "open", "title": p["title"],
                     "body": p["body"], "html_url": URL, "user": rest_user(SCN["author"]), "draft": False,
                     "merged": STATE["merged"], "head": {"ref": SCN["head"], "sha": p["headRefOid"]},
                     "base": {"ref": SCN["base"], "sha": p["baseRefOid"]}}, args)
    if path == f"{base}/pulls/{N}/merge" and method == "PUT":
        merge()
        return emit({"merged": True}, args)
    if path == f"{base}/pulls/{N}/files":
        return emit(changed_files(), args)
    if path == f"{base}/pulls/{N}/commits":
        return emit([{"sha": c["oid"]} for c in pr_json()["commits"]], args)
    if path == f"{base}/pulls/{N}/comments" and method == "GET":
        return emit([rest_comment(t, c) for t in thread_nodes() for c in t["comments"]["nodes"]], args)
    m = re.fullmatch(rf"{re.escape(base)}/pulls/{N}/comments/(\d+)/replies", path)
    if m or (path == f"{base}/pulls/{N}/comments" and method == "POST"):
        tid = thread_of_comment(m.group(1) if m else str(v.get("in_reply_to", "")))
        if not tid:
            print("gh: Not Found (HTTP 404)", file=sys.stderr)
            return 1
        r = add_reply(tid, v.get("body", ""))
        return emit({"id": r["databaseId"], "node_id": r["id"], "body": r["body"], "html_url": r["url"]}, args)
    m = re.fullmatch(rf"{re.escape(base)}/pulls/comments/(\d+)", path)
    if m:
        if method in ("PATCH", "POST"):
            STATE["edits"].append({"comment": m.group(1), "body": v.get("body"), **stamp()})
            return emit({"id": int(m.group(1))}, args)
        for t in thread_nodes():
            for c in t["comments"]["nodes"]:
                if str(c["databaseId"]) == m.group(1):
                    return emit(rest_comment(t, c), args)
    if path == f"{base}/issues/{N}/comments":
        if method == "POST":
            c = add_comment(v.get("body", ""))
            return emit({"id": c["databaseId"], "node_id": c["id"], "html_url": c["url"]}, args)
        return emit([{"id": c["databaseId"], "node_id": c["id"], "user": rest_user(c["author"]["login"]),
                      "body": c["body"], "html_url": c["url"], "created_at": c["createdAt"]} for c in comment_nodes()],
                    args)
    if path == f"{base}/pulls/{N}/reviews":
        if method == "POST":
            r = add_review(v.get("event", "COMMENT"), v.get("body", ""))
            return emit({"id": 1, "state": r["state"]}, args)
        return emit([{"id": r["databaseId"] if "databaseId" in r else 1, "node_id": r["id"],
                      "user": rest_user(r["author"]["login"]), "state": r["state"], "body": r["body"],
                      "commit_id": r["commit"]["oid"], "html_url": r["url"], "submitted_at": r["submittedAt"]}
                     for r in review_nodes()], args)
    m = re.fullmatch(rf"{re.escape(base)}/compare/([^.]+)\.\.\.(.+)", path)
    if m:
        a, b = m.groups()
        try:
            ra, rb = git("rev-parse", a), git("rev-parse", b)
        except subprocess.CalledProcessError:
            print(f"gh: No commit found for SHA: {a} (HTTP 404)", file=sys.stderr)
            return 1
        ahead = int(git("rev-list", "--count", f"{ra}..{rb}"))
        behind = int(git("rev-list", "--count", f"{rb}..{ra}"))
        status = "identical" if ra == rb else "ahead" if behind == 0 else "behind" if ahead == 0 else "diverged"
        return emit({"status": status, "ahead_by": ahead, "behind_by": behind, "base_commit": {"sha": ra},
                     "commits": [{"sha": s} for s in git("rev-list", "--reverse", f"{ra}..{rb}").splitlines()]}, args)
    m = re.fullmatch(rf"{re.escape(base)}/commits/([0-9a-f]+)", path)
    if m:
        try:
            sha = git("rev-parse", m.group(1))
        except subprocess.CalledProcessError:
            print(f"gh: No commit found for SHA: {m.group(1)} (HTTP 422)", file=sys.stderr)
            return 1
        return emit({"sha": sha, "commit": {"message": git("log", "-1", "--format=%B", sha)}}, args)
    m = re.fullmatch(rf"{re.escape(base)}/issues/(\d+)", path)
    if m:
        issue = next((i for i in SCN.get("issues", []) if i["number"] == int(m.group(1))), None)
        if issue:
            return emit({"number": issue["number"], "title": issue["title"], "body": issue["body"], "state": "open",
                         "html_url": f"https://{HOST}/{SCN['repo']}/issues/{issue['number']}"}, args)
    print(f"stub: unsupported api path {method} {path}", file=sys.stderr)
    return 1


# ---------- subcommands ----------

def text_view(with_comments):
    p = pr_json()
    out = [f"title:\t{p['title']}", f"state:\t{p['state']}", f"author:\t{SCN['author']}", f"number:\t{N}",
           f"url:\t{URL}", "--", p["body"]]
    if with_comments:
        for r in p["reviews"]:
            if r["body"]:
                out += ["--", f"author:\t{r['author']['login']}", f"state:\t{r['state']}", "--", r["body"]]
        for c in p["comments"]:
            out += ["--", f"author:\t{c['author']['login']}", "--", c["body"]]
    print("\n".join(out))
    return 0


def pr_cmd(args):
    sub, rest_args = args[0], args[1:]
    if sub == "view":
        if "--json" in rest_args:
            return emit(select(pr_json(), flag(rest_args, "--json")), rest_args)
        return text_view("--comments" in rest_args or "-c" in rest_args)
    if sub == "diff":
        if "--name-only" in rest_args:
            print("\n".join(f["path"] for f in changed_files()))
            return 0
        print(git("diff", f"{base_sha()}...{head()}"))
        return 0
    if sub == "list":
        row = select(pr_json(), flag(rest_args, "--json") or "number,title,url,headRefName")
        return emit([row], rest_args) if "--json" in rest_args else (print(f"{N}\t{SCN['title']}\t{SCN['head']}") or 0)
    if sub == "checks":
        print(f"test\tpass\t1m\thttps://{HOST}/{SCN['repo']}/actions/runs/1")
        return 0
    if sub == "comment":
        c = add_comment(body_arg(rest_args))
        print(c["url"])
        return 0
    if sub == "review":
        event = "APPROVE" if ("--approve" in rest_args or "-a" in rest_args) else \
            "REQUEST_CHANGES" if ("--request-changes" in rest_args or "-r" in rest_args) else "COMMENT"
        add_review(event, body_arg(rest_args))
        print(f"- Reviewed pull request {SCN['repo']}#{N}")
        return 0
    if sub == "merge":
        merge()
        print(f"✓ Merged pull request {SCN['repo']}#{N} ({SCN['title']})")
        return 0
    if sub == "checkout":
        subprocess.run(["git", "fetch", "-q", "origin"], check=True)
        subprocess.run(["git", "checkout", "-q", SCN["head"]], check=True)
        return 0
    if sub in ("edit", "ready"):
        STATE["edits"].append({"pr": args, **stamp()})
        print(URL)
        return 0
    print(f"stub: unsupported pr {sub}", file=sys.stderr)
    return 1


def issue_cmd(args):
    sub, rest_args = args[0], args[1:]
    num = next((int(a.lstrip("#")) for a in rest_args if a.lstrip("#").isdigit()), None)
    if sub == "view":
        issue = next((i for i in SCN.get("issues", []) if i["number"] == num), None)
        if num == N:
            return pr_cmd(["view", *rest_args])
        if not issue:
            print(f"GraphQL: Could not resolve to an issue or pull request with the number of {num}.", file=sys.stderr)
            return 1
        obj = {"number": issue["number"], "title": issue["title"], "body": issue["body"], "state": "OPEN",
               "url": f"https://{HOST}/{SCN['repo']}/issues/{issue['number']}", "comments": [], "labels": []}
        if "--json" in rest_args:
            return emit(select(obj, flag(rest_args, "--json")), rest_args)
        print(f"title:\t{obj['title']}\nstate:\tOPEN\nnumber:\t{num}\n--\n{obj['body']}")
        return 0
    if sub == "comment" and num == N:
        return pr_cmd(["comment", *rest_args])
    print(f"stub: unsupported issue {sub}", file=sys.stderr)
    return 1


def record_pushed():
    first = STATE.get("initial_head")
    if not first:
        return
    now = head()
    kept = subprocess.run(["git", "--git-dir", str(REMOTE), "merge-base", "--is-ancestor", first, now]).returncode == 0
    (STUB / "pushed.diff").write_text(f"history: {'kept' if kept else 'rewritten'}\nhead: {now}\n"
                                      f"{git('diff', first, now)}\n")


def main():
    args = sys.argv[1:]
    clean, skip = [], False
    for a in args:
        if skip:
            skip = False
            continue
        if a in ("-R", "--repo"):
            skip = True
            continue
        if not a.startswith("--repo="):
            clean.append(a)
    with open(STUB / "calls.log", "a") as log:
        log.write(shlex.join(["gh", *args]) + "\n")
    if not clean or clean[0] in ("--version", "version"):
        print("gh version 2.103.3 (2026-10-26)")
        return 0
    cmd, rest_args = clean[0], clean[1:]
    try:
        if "--help" in rest_args or "-h" in rest_args:
            print(f"stub gh: help for `gh {' '.join(rest_args[:2])}` is not available here; run it without --help")
            return 0
        if cmd == "pr" and rest_args:
            return pr_cmd(rest_args)
        if cmd == "issue" and rest_args:
            return issue_cmd(rest_args)
        if cmd == "api" and rest_args:
            return graphql(rest_args) if rest_args[0] == "graphql" else rest(["api", *rest_args])
        if cmd == "auth":
            print(f"{HOST}\n  ✓ Logged in to {HOST} account {VIEWER} (keyring)")
            return 0
        if cmd == "repo" and rest_args[:1] == ["view"]:
            return emit(select({"nameWithOwner": SCN["repo"], "name": REPO, "owner": {"login": OWNER},
                                "defaultBranchRef": {"name": SCN["base"]}, "url": f"https://{HOST}/{SCN['repo']}"},
                               flag(rest_args, "--json")), rest_args)
        print(f"stub: unsupported command gh {' '.join(args)}", file=sys.stderr)
        return 1
    finally:
        record_pushed()
        STATE_FILE.write_text(json.dumps(STATE, indent=1))


if __name__ == "__main__":
    sys.exit(main())
